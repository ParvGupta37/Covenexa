# =============================================================
# Covenexa — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================

# ── APPLICATION ──────────────────────────────────────────────
APP_ENV=development
APP_NAME=Covenexa
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ── BACKEND ──────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
BACKEND_RELOAD=true

# ── SECURITY ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── POSTGRESQL ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=covenexa_user
POSTGRES_PASSWORD=covenexa_pass
POSTGRES_DB=covenexa
DATABASE_URL=postgresql+asyncpg://covenexa_user:covenexa_pass@postgres:5432/covenexa
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── NEO4J ────────────────────────────────────────────────────
NEO4J_HOST=neo4j
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=covenexa_neo4j_pass
NEO4J_URI=bolt://neo4j:7687
NEO4J_AUTH=neo4j/covenexa_neo4j_pass

# ── REDIS ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=covenexa_redis_pass
REDIS_DB=0
REDIS_URL=redis://:covenexa_redis_pass@redis:6379/0
REDIS_EVENT_BUS_DB=1
REDIS_MEMORY_DB=2

# ── PGADMIN ──────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@covenexa.ai
PGADMIN_DEFAULT_PASSWORD=covenexa_pgadmin_pass

# ── MCP SERVER ───────────────────────────────────────────────
MCP_SERVER_HOST=mcp_server
MCP_SERVER_PORT=8001
MCP_SERVER_URL=http://mcp_server:8001

# ── FILE STORAGE ─────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,xlsx,csv,txt

# ── PINECONE (Sprint 2) ───────────────────────────────────────
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=covenexa-docs
PINECONE_DIMENSION=1024

# ── COHERE (Sprint 2) ─────────────────────────────────────────
COHERE_API_KEY=
COHERE_LLM_MODEL=command-a-03-2025
COHERE_EMBED_MODEL=embed-v4.0
COHERE_MAX_TOKENS=4096

# ── LLAMA PARSE (Sprint 2) ────────────────────────────────────
LLAMA_CLOUD_API_KEY=

# ── FRONTEND ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=Covenexa
VITE_APP_ENV=development

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── MONITORING (Sprint 5) ────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=covenexa_grafana_pass
